---

<section class="my-10 rounded border border-dashed px-6 py-6">
  <h2 class="font-serif text-lg font-bold text-foreground">
    The Decoded Dispatch
  </h2>
  <p class="mt-1 mb-5 text-sm opacity-70">
    Bi-weekly implementation notes for practitioners applying AI in public health and data science.
  </p>

  <form
    action="https://app.kit.com/forms/9454366/subscriptions"
    class="seva-form"
    method="post"
    data-sv-form="9454366"
    data-uid="754a57616a"
    data-format="inline"
    data-version="5"
  >
    <div
      data-element="fields"
      class="seva-fields flex flex-col gap-3 sm:flex-row"
    >
      <div class="formkit-field flex-1">
        <input
          class="formkit-input w-full rounded border border-dashed bg-background px-3 py-2 text-sm text-foreground placeholder:opacity-50 focus:outline-none focus:ring-1 focus:ring-accent"
          name="email_address"
          aria-label="Email Address"
          placeholder="your@email.com"
          required
          type="email"
        />
      </div>
      <button
        data-element="submit"
        class="formkit-submit cursor-pointer rounded bg-accent px-4 py-2 text-sm font-medium text-white hover:opacity-90"
      >
        <div class="formkit-spinner hidden">
          <div></div>
          <div></div>
          <div></div>
        </div>
        <span>Subscribe</span>
      </button>
    </div>

    <ul
      class="formkit-alert formkit-alert-error mt-3 hidden list-none text-sm text-red-500"
      data-element="errors"
      data-group="alert"
    >
    </ul>
  </form>

  <p class="mt-4 text-xs opacity-50">No spam. Unsubscribe at any time.</p>
</section>

<script src="https://f.convertkit.com/ckjs/ck.5.js"></script>
